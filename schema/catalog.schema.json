{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quvantic.com/schemas/make-blueprint-catalog.schema.json",
  "title": "make-blueprint-library catalog",
  "description": "Machine-readable index of portfolio Make.com blueprints. See CATALOG_SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "apps",
        "difficulty",
        "tags",
        "path",
        "description",
        "test_status",
        "screenshot"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 8 },
        "category": { "type": "string", "minLength": 2 },
        "apps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
        "tags": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "path": { "type": "string", "pattern": "^scenarios/[a-z0-9-]+/[a-z0-9-]+$" },
        "description": { "type": "string", "minLength": 20 },
        "test_status": { "type": "string", "const": "documented blueprint, structurally validated" },
        "screenshot": { "type": "string", "pattern": "^scenarios/[a-z0-9-]+/[a-z0-9-]+/diagram\\.png$" }
      }
    }
  }
}
