{
  "name": "Qualify a chat widget transcript into HubSpot",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Catch the webhook"
        }
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {},
      "mapper": {
        "select": "chat",
        "model": "gpt-4o-mini",
        "max_tokens": "300",
        "temperature": "0.2",
        "messages": [
          {
            "role": "system",
            "content": "Read a chat transcript. Return JSON only: score (0-100), reason. Score at least 70 only if the transcript contains an email and a concrete need."
          },
          {
            "role": "user",
            "content": "Transcript:\n{{1.transcript}}\nClaimed email: {{1.email}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Score the payload"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:openai-gpt-3",
            "label": "Connection",
            "required": true
          }
        ]
      },
      "onerror": [
        {
          "id": 3,
          "module": "slack:CreateMessage",
          "version": 4,
          "parameters": {},
          "mapper": {
            "channelWType": "list",
            "channelType": "public",
            "channel": "",
            "text": "Scoring failed.",
            "mrkdwn": true,
            "parse": false
          },
          "metadata": {
            "designer": {
              "x": 300,
              "y": 300,
              "name": "Alert scoring"
            },
            "parameters": [
              {
                "name": "__IMTCONN__",
                "type": "account:slack2,slack3",
                "label": "Connection",
                "required": true
              }
            ]
          }
        },
        {
          "id": 4,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {
            "retry": true,
            "count": 3,
            "interval": 15
          },
          "metadata": {
            "designer": {
              "x": 600,
              "y": 300,
              "name": "Retry (Break)"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{2.result}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Parse the score"
        }
      }
    },
    {
      "id": 6,
      "module": "google-sheets:addRow",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "",
        "sheetId": "",
        "includesHeaders": true,
        "insertDataOption": "INSERT_ROWS",
        "valueInputOption": "USER_ENTERED",
        "values": {
          "0": "{{now}}",
          "1": "{{1.email}}",
          "2": "{{5.score}}",
          "3": "{{5.reason}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Log it"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 7,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Branch on the score"
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 8,
              "module": "hubspotcrm:createContact",
              "version": 2,
              "parameters": {},
              "mapper": {
                "email": "{{1.email}}",
                "firstname": "{{1.first_name}}",
                "lastname": "{{1.last_name}}"
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 0,
                  "name": "Act on the high score"
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account:hubspotcrm",
                    "label": "Connection",
                    "required": true
                  }
                ]
              },
              "filter": {
                "name": "At or above the line",
                "conditions": [
                  [
                    {
                      "a": "{{5.score}}",
                      "o": "number:greaterorequal",
                      "b": "70"
                    }
                  ]
                ]
              },
              "onerror": [
                {
                  "id": 9,
                  "module": "slack:CreateMessage",
                  "version": 4,
                  "parameters": {},
                  "mapper": {
                    "channelWType": "list",
                    "channelType": "public",
                    "channel": "",
                    "text": "HubSpot create failed.",
                    "mrkdwn": true,
                    "parse": false
                  },
                  "metadata": {
                    "designer": {
                      "x": 1500,
                      "y": 300,
                      "name": "Alert HubSpot"
                    },
                    "parameters": [
                      {
                        "name": "__IMTCONN__",
                        "type": "account:slack2,slack3",
                        "label": "Connection",
                        "required": true
                      }
                    ]
                  }
                },
                {
                  "id": 10,
                  "module": "builtin:Break",
                  "version": 1,
                  "parameters": {},
                  "mapper": {
                    "retry": true,
                    "count": 3,
                    "interval": 15
                  },
                  "metadata": {
                    "designer": {
                      "x": 1800,
                      "y": 300,
                      "name": "Retry (Break)"
                    }
                  }
                }
              ]
            },
            {
              "id": 11,
              "module": "slack:CreateMessage",
              "version": 4,
              "parameters": {},
              "mapper": {
                "channelWType": "list",
                "channelType": "public",
                "channel": "",
                "text": "Chat became a contact: {{1.email}}. {{5.reason}}",
                "mrkdwn": true,
                "parse": false
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": 0,
                  "name": "Tell the channel"
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account:slack2,slack3",
                    "label": "Connection",
                    "required": true
                  }
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 12,
              "module": "slack:CreateMessage",
              "version": 4,
              "parameters": {},
              "mapper": {
                "channelWType": "list",
                "channelType": "public",
                "channel": "",
                "text": "Chat logged, no contact: {{1.email}} score {{5.score}}.",
                "mrkdwn": true,
                "parse": false
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 300,
                  "name": "Note the low score"
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account:slack2,slack3",
                    "label": "Connection",
                    "required": true
                  }
                ]
              },
              "filter": {
                "name": "Below the line",
                "conditions": [
                  [
                    {
                      "a": "{{5.score}}",
                      "o": "number:less",
                      "b": "70"
                    }
                  ]
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "designer": {
      "orphans": []
    },
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": true,
      "freshVariables": false
    }
  }
}
