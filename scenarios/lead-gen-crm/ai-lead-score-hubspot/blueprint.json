{
  "name": "AI lead capture, score, and HubSpot contact",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Catch the form webhook"
        }
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {},
      "mapper": {
        "select": "chat",
        "model": "gpt-4o-mini",
        "max_tokens": "300",
        "temperature": "0.2",
        "messages": [
          {
            "role": "system",
            "content": "You qualify B2B leads. Return JSON only, with keys score (0-100), band (hot, nurture, or low), and reason (one sentence)."
          },
          {
            "role": "user",
            "content": "Score this lead. Hot means they named a timeline or a budget. Nurture means a real company with a vague need. Low means student, spam, or no way to reply.\n\n{{1.first_name}} {{1.last_name}} <{{1.email}}> at {{1.company}}\n{{1.message}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Score the lead"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:openai-gpt-3",
            "label": "Connection",
            "required": true
          }
        ]
      },
      "onerror": [
        {
          "id": 3,
          "module": "slack:CreateMessage",
          "version": 4,
          "parameters": {},
          "mapper": {
            "channelWType": "list",
            "channelType": "public",
            "channel": "",
            "text": "Lead scoring failed for {{1.email}}.",
            "mrkdwn": true,
            "parse": false
          },
          "metadata": {
            "designer": {
              "x": 300,
              "y": 300,
              "name": "Tell the channel"
            },
            "parameters": [
              {
                "name": "__IMTCONN__",
                "type": "account:slack2,slack3",
                "label": "Connection",
                "required": true
              }
            ]
          }
        },
        {
          "id": 4,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {
            "retry": true,
            "count": 3,
            "interval": 15
          },
          "metadata": {
            "designer": {
              "x": 600,
              "y": 300,
              "name": "Retry (Break)"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{2.result}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Parse score JSON"
        }
      }
    },
    {
      "id": 6,
      "module": "google-sheets:addRow",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "",
        "sheetId": "",
        "includesHeaders": true,
        "insertDataOption": "INSERT_ROWS",
        "valueInputOption": "USER_ENTERED",
        "values": {
          "0": "{{now}}",
          "1": "{{1.email}}",
          "2": "{{1.company}}",
          "3": "{{5.score}}",
          "4": "{{5.reason}}",
          "5": "{{5.band}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Log the lead and the score"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 7,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Branch on the score"
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 8,
              "module": "hubspotcrm:createContact",
              "version": 2,
              "parameters": {},
              "mapper": {
                "email": "{{1.email}}",
                "firstname": "{{1.first_name}}",
                "lastname": "{{1.last_name}}",
                "company": "{{1.company}}",
                "phone": "{{1.phone}}"
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 0,
                  "name": "Create the HubSpot contact"
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account:hubspotcrm",
                    "label": "Connection",
                    "required": true
                  }
                ]
              },
              "filter": {
                "name": "Score at least 70",
                "conditions": [
                  [
                    {
                      "a": "{{5.score}}",
                      "o": "number:greaterorequal",
                      "b": "70"
                    }
                  ]
                ]
              },
              "onerror": [
                {
                  "id": 9,
                  "module": "slack:CreateMessage",
                  "version": 4,
                  "parameters": {},
                  "mapper": {
                    "channelWType": "list",
                    "channelType": "public",
                    "channel": "",
                    "text": "HubSpot create failed for {{1.email}} (score {{5.score}}).",
                    "mrkdwn": true,
                    "parse": false
                  },
                  "metadata": {
                    "designer": {
                      "x": 1500,
                      "y": 300,
                      "name": "Tell the channel"
                    },
                    "parameters": [
                      {
                        "name": "__IMTCONN__",
                        "type": "account:slack2,slack3",
                        "label": "Connection",
                        "required": true
                      }
                    ]
                  }
                },
                {
                  "id": 10,
                  "module": "builtin:Break",
                  "version": 1,
                  "parameters": {},
                  "mapper": {
                    "retry": true,
                    "count": 3,
                    "interval": 15
                  },
                  "metadata": {
                    "designer": {
                      "x": 1800,
                      "y": 300,
                      "name": "Retry (Break)"
                    }
                  }
                }
              ]
            },
            {
              "id": 11,
              "module": "slack:CreateMessage",
              "version": 4,
              "parameters": {},
              "mapper": {
                "channelWType": "list",
                "channelType": "public",
                "channel": "",
                "text": "*Hot lead* {{1.first_name}} {{1.last_name}} at {{1.company}} — {{5.score}}. {{5.reason}}",
                "mrkdwn": true,
                "parse": false
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": 0,
                  "name": "Ping sales"
                },
                "parameters": [
                  {
                    "name": "__IMTCONN__",
                    "type": "account:slack2,slack3",
                    "label": "Connection",
                    "required": true
                  }
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 12,
              "module": "google-email:ActionCreateDraft",
              "version": 2,
              "parameters": {},
              "mapper": {
                "from": "",
                "to": [
                  "{{1.email}}"
                ],
                "cc": [],
                "bcc": [],
                "replyTo": "",
                "subject": "Re: {{1.company}} and the form you just sent",
                "html": "<p>Hi {{1.first_name}},</p><p>Thanks for the note from {{1.company}}. We read this as: {{5.reason}}</p><p>Worth a 20-minute look this week?</p>",
                "attachments": []
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 300,
                  "name": "Draft the first touch"
                },
                "parameters": [
                  {
                    "name": "account",
                    "type": "account:google-restricted",
                    "label": "Connection",
                    "required": true
                  }
                ]
              },
              "filter": {
                "name": "Between 40 and 69",
                "conditions": [
                  [
                    {
                      "a": "{{5.score}}",
                      "o": "number:greaterorequal",
                      "b": "40"
                    },
                    {
                      "a": "{{5.score}}",
                      "o": "number:less",
                      "b": "70"
                    }
                  ]
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "designer": {
      "orphans": []
    },
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": true,
      "freshVariables": false
    }
  }
}
