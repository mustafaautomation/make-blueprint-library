{
  "name": "Fetch a company page and write a summary back to the sheet",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "mode": "select",
        "from": "drive",
        "spreadsheetId": "",
        "sheetId": "",
        "includesHeaders": true,
        "tableFirstRow": "A1:Z1",
        "limit": 5,
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Watch new domains"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://{{1.`0`}}",
        "serializeUrl": false,
        "method": "get",
        "headers": [
          {
            "name": "Accept",
            "value": "application/json"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "data": "",
        "timeout": "",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Fetch the homepage"
        }
      },
      "onerror": [
        {
          "id": 3,
          "module": "slack:CreateMessage",
          "version": 4,
          "parameters": {},
          "mapper": {
            "channelWType": "list",
            "channelType": "public",
            "channel": "",
            "text": "Could not fetch https://{{1.`0`}}",
            "mrkdwn": true,
            "parse": false
          },
          "metadata": {
            "designer": {
              "x": 300,
              "y": 300,
              "name": "Alert fetch"
            },
            "parameters": [
              {
                "name": "__IMTCONN__",
                "type": "account:slack2,slack3",
                "label": "Connection",
                "required": true
              }
            ]
          }
        },
        {
          "id": 4,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {
            "retry": true,
            "count": 3,
            "interval": 15
          },
          "metadata": {
            "designer": {
              "x": 600,
              "y": 300,
              "name": "Retry (Break)"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "module": "regexp:HTMLToText",
      "version": 1,
      "parameters": {},
      "mapper": {
        "html": "{{2.data}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Drop the tags"
        }
      }
    },
    {
      "id": 6,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {},
      "mapper": {
        "select": "chat",
        "model": "gpt-4o-mini",
        "max_tokens": "220",
        "temperature": "0.2",
        "messages": [
          {
            "role": "system",
            "content": "Summarize a homepage in two sentences. Use only the text. Do not guess funding, revenue, or headcount."
          },
          {
            "role": "user",
            "content": "Domain: {{1.`0`}}\n\n{{5.text}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Summarize the page"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:openai-gpt-3",
            "label": "Connection",
            "required": true
          }
        ]
      },
      "onerror": [
        {
          "id": 7,
          "module": "slack:CreateMessage",
          "version": 4,
          "parameters": {},
          "mapper": {
            "channelWType": "list",
            "channelType": "public",
            "channel": "",
            "text": "Summary failed for {{1.`0`}}",
            "mrkdwn": true,
            "parse": false
          },
          "metadata": {
            "designer": {
              "x": 900,
              "y": 300,
              "name": "Alert summary"
            },
            "parameters": [
              {
                "name": "__IMTCONN__",
                "type": "account:slack2,slack3",
                "label": "Connection",
                "required": true
              }
            ]
          }
        },
        {
          "id": 8,
          "module": "builtin:Ignore",
          "version": 1,
          "parameters": {},
          "mapper": {},
          "metadata": {
            "designer": {
              "x": 1200,
              "y": 300,
              "name": "Skip (Ignore)"
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {},
      "mapper": {
        "mode": "map",
        "spreadsheetId": "",
        "sheetId": "",
        "rowNumber": "{{1.__ROW_NUMBER__}}",
        "tableFirstRow": "A1:Z1",
        "includesHeaders": true,
        "valueInputOption": "USER_ENTERED",
        "values": {
          "1": "{{6.result}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Write column B"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google",
            "label": "Connection",
            "required": true
          }
        ]
      },
      "filter": {
        "name": "Summary exists",
        "conditions": [
          [
            {
              "a": "{{6.result}}",
              "o": "exist"
            }
          ]
        ]
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "designer": {
      "orphans": []
    },
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": true,
      "freshVariables": false
    }
  }
}
