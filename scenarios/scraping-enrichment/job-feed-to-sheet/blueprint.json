{
  "name": "Job RSS items scored into a sheet",
  "flow": [
    {
      "id": 1,
      "module": "rss:TriggerNewArticle",
      "version": 1,
      "parameters": {},
      "mapper": {
        "url": "https://example.com/jobs.xml",
        "maxResults": 2
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Watch the feed"
        }
      }
    },
    {
      "id": 2,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {},
      "mapper": {
        "select": "chat",
        "model": "gpt-4o-mini",
        "max_tokens": "350",
        "temperature": "0.2",
        "messages": [
          {
            "role": "system",
            "content": "Summarize the job in two sentences from the title and description. Say if it is an operations role: yes or no. Do not invent salary."
          },
          {
            "role": "user",
            "content": "Title: {{1.title}}\n{{1.url}}\n{{1.description}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Summarize the item"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:openai-gpt-3",
            "label": "Connection",
            "required": true
          }
        ]
      },
      "onerror": [
        {
          "id": 3,
          "module": "slack:CreateMessage",
          "version": 4,
          "parameters": {},
          "mapper": {
            "channelWType": "list",
            "channelType": "public",
            "channel": "",
            "text": "Feed item failed: {{1.title}}",
            "mrkdwn": true,
            "parse": false
          },
          "metadata": {
            "designer": {
              "x": 300,
              "y": 300,
              "name": "Alert feed"
            },
            "parameters": [
              {
                "name": "__IMTCONN__",
                "type": "account:slack2,slack3",
                "label": "Connection",
                "required": true
              }
            ]
          }
        },
        {
          "id": 4,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {
            "retry": true,
            "count": 3,
            "interval": 15
          },
          "metadata": {
            "designer": {
              "x": 600,
              "y": 300,
              "name": "Retry (Break)"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "module": "google-sheets:addRow",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "",
        "sheetId": "",
        "includesHeaders": true,
        "insertDataOption": "INSERT_ROWS",
        "valueInputOption": "USER_ENTERED",
        "values": {
          "0": "{{now}}",
          "1": "{{1.title}}",
          "2": "{{1.url}}",
          "3": "{{2.result}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Archive the item"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 6,
      "module": "slack:CreateMessage",
      "version": 4,
      "parameters": {},
      "mapper": {
        "channelWType": "list",
        "channelType": "public",
        "channel": "",
        "text": "*Role* {{2.result}}\n{{1.url}}",
        "mrkdwn": true,
        "parse": false
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Post it"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:slack2,slack3",
            "label": "Connection",
            "required": true
          }
        ]
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "designer": {
      "orphans": []
    },
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": true,
      "freshVariables": false
    }
  }
}
